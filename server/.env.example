# ========================================
# Jan Sunwai Video Call — Server Configuration
# ========================================

# Server
PORT=3001
NODE_ENV=development

# JWT Secret for OTP-based authentication
JWT_SECRET=jan-sunwai-dev-secret-change-in-production

# LiveKit Configuration
# For local development, run: docker run -d --rm -p 7880:7880 -p 7881:7881 -p 7882:7882/udp \
#   -e LIVEKIT_KEYS="devkey: devsecret" livekit/livekit-server
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# Redis (for production call state management)
# REDIS_URL=redis://localhost:6379

# FCM (for production Android push notifications)
# FCM_SERVER_KEY=your-fcm-server-key
# FCM_PROJECT_ID=your-firebase-project-id

# APNs (for production iOS push notifications)
# APNS_KEY_ID=your-apns-key-id
# APNS_TEAM_ID=your-apple-team-id
